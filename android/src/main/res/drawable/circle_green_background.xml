<!-- res/drawable/circle_green_icon.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#4AAB24" /> <!-- Dark green color -->
        </shape>
    </item>

    <!-- Inner Circle with Padding -->
    <item

        android:top="4dp"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="#D0EEC4" /> <!-- Light green color -->
        </shape>
    </item>

</layer-list>